  },
  "platforms": [
    {
      "id": "youtube_shorts",
      "displayName": "YouTube Shorts",
      "packages": ["com.google.android.youtube"],
      "appVersionRange": { "minCode": 0, "maxCode": null },
      "surfaces": [
        {
          "id": "shorts_player",
          "confidence": "STRONG",
