            {
              "by": "viewId",
              "op": "equals",
              "value": "com.google.android.youtube:id/reel_recycler",
              "visible": true
            }
          ],
          "exclude": [],
          "action": "BACK"
        },
        {
          "id": "shorts_tab_selected",
          "confidence": "WEAK",
          "matchAll": [
            {
              "by": "contentDesc",
              "op": "equals",
              "value": "Shorts",
              "selected": true
            }
          ],
          "exclude": [],
          "action": "BACK"
        }
      ]
    },
